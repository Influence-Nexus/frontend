    "format": "prettier --check \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\" \"**/*.test.{js,jsx}\"",
    "format:fix": "prettier --write \"src/**/*.{js,jsx,ts,tsx,json,css,scss,md}\" \"**/*.test.{js,jsx}\"",
    "test": "npm run clean:coverage && vitest",
    "test:coverage": "npm run clean:coverage && vitest run --coverage",
    "cap:sync": "cap sync",
    "cap:copy": "cap copy",
    "cap:open": "cap open"
  },
